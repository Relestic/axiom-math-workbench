# Copy to deploy/.env and replace every placeholder before deployment.
AXIOM_ENV=production
AXIOM_SECRET_KEY=replace-with-a-random-48-byte-value
AXIOM_ADMIN_EMAIL=admin@example.com
AXIOM_ADMIN_PASSWORD=replace-with-a-strong-random-password
AXIOM_DEMO_INVITE_CODE=replace-with-a-random-invite-code

# Persistent SQLite path inside the container (Docker volume mounts /app/backend/var-online).
AXIOM_DB_URL=sqlite:////app/backend/var-online/online.db
AXIOM_DATA_DIR=/app/backend/var-online
AXIOM_DOCS_ENABLED=false
AXIOM_WORKER_ENABLED=true

# DeepSeek (required for AI features; the image does not contain a key).
AXIOM_AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_API_KEY=sk-replace-with-your-deepseek-key
AI_JSON_MODE=true
AXIOM_LEGACY_AI=true
AXIOM_AI_DAILY_CALL_LIMIT=200
AXIOM_AI_LEGACY_DAILY_LIMIT=80

# Aliyun / mainland China build mirrors (optional; uncomment if npm/pip are slow).
# NPM_REGISTRY=https://registry.npmmirror.com
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

# Same-origin deployment does not require CORS. Set your public origin if a
# separate frontend domain is used.
# AXIOM_CORS_ORIGINS=https://axiom.example.com
