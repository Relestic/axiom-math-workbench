# Frontend → backend API base URL. The default local backend runs on port 8000.
VITE_API_BASE=http://127.0.0.1:8000

# OpenAI-compatible API base URL; the Vite-local fallback middleware appends /chat/completions.
AI_BASE_URL=https://api.openai.com/v1
# Use a model ID offered by your configured provider.
AI_MODEL=
AI_API_KEY=
# Set false only if your provider does not support response_format JSON mode.
AI_JSON_MODE=true
