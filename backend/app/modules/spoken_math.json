{
  "rules": [
    [
      "\\\\(?:left|right|displaystyle|quad|qquad)(?![A-Za-z])",
      " "
    ],
    [
      "\\\\(?:,|;|!|:|\\\\)",
      " "
    ],
    [
      "\\\\forall(?![A-Za-z])",
      "∀"
    ],
    [
      "\\\\exists(?![A-Za-z])",
      "∃"
    ],
    [
      "\\\\varepsilon(?![A-Za-z])",
      "ε"
    ],
    [
      "\\\\epsilon(?![A-Za-z])",
      "ε"
    ],
    [
      "\\\\delta(?![A-Za-z])",
      "δ"
    ],
    [
      "\\\\int(?![A-Za-z])",
      "∫"
    ],
    [
      "\\\\infty(?![A-Za-z])",
      "∞"
    ],
    [
      "\\\\leq(?![A-Za-z])",
      "≤"
    ],
    [
      "\\\\geq(?![A-Za-z])",
      "≥"
    ],
    [
      "\\\\le(?![A-Za-z])",
      "≤"
    ],
    [
      "\\\\ge(?![A-Za-z])",
      "≥"
    ],
    [
      "\\\\in(?![A-Za-z])",
      "∈"
    ],
    [
      "\\\\to(?![A-Za-z])",
      "→"
    ],
    [
      "\\\\rightarrow(?![A-Za-z])",
      "→"
    ],
    [
      "\\\\Rightarrow(?![A-Za-z])",
      "⇒"
    ],
    [
      "\\\\neq(?![A-Za-z])",
      "≠"
    ],
    [
      "\\\\ne(?![A-Za-z])",
      "≠"
    ],
    [
      "\\\\cdot(?![A-Za-z])",
      "·"
    ],
    [
      "\\\\times(?![A-Za-z])",
      "×"
    ],
    [
      "\\\\sum(?![A-Za-z])",
      "∑"
    ],
    [
      "\\\\pi(?![A-Za-z])",
      "π"
    ],
    [
      "\\\\theta(?![A-Za-z])",
      "θ"
    ],
    [
      "\\\\xi(?![A-Za-z])",
      "ξ"
    ],
    [
      "\\\\alpha(?![A-Za-z])",
      "α"
    ],
    [
      "\\\\beta(?![A-Za-z])",
      "β"
    ],
    [
      "\\\\(?:text|mathrm|mathbf|operatorname)\\{([^{}]*)\\}",
      "$1"
    ],
    [
      "\\\\mathbb\\{R\\}",
      "实数集"
    ],
    [
      "\\\\frac\\s*\\{([^{}]+)\\}\\s*\\{([^{}]+)\\}",
      "（$2）分之（$1）"
    ],
    [
      "\\\\sqrt\\{([^{}]+)\\}",
      "根号（$1）"
    ],
    [
      "∫\\s*_\\{?([a-zA-Z0-9]+)\\}?\\s*\\^\\{?([a-zA-Z0-9]+)\\}?",
      "从 $1 到 $2 的积分"
    ],
    [
      "∀\\s*ε\\s*>\\s*0",
      "对于任意大于零的伊普西隆"
    ],
    [
      "∃\\s*δ\\s*>\\s*0",
      "存在大于零的德尔塔"
    ],
    [
      "\\^\\{?2\\}?|²",
      "的平方"
    ],
    [
      "\\^\\{?3\\}?|³",
      "的立方"
    ],
    [
      "_\\{([^{}]+)\\}|_([A-Za-z0-9])",
      "下标$1$2"
    ],
    [
      "\\^\\{([^{}]+)\\}",
      "的 $1 次方"
    ]
  ],
  "symbols": {
    "∀": "对于任意",
    "∃": "存在",
    "ε": "伊普西隆",
    "δ": "德尔塔",
    "ξ": "克西",
    "θ": "西塔",
    "α": "阿尔法",
    "β": "贝塔",
    "π": "派",
    "∫": "积分",
    "∑": "求和",
    "∞": "无穷大",
    "∈": "属于",
    "ℝ": "实数集",
    "→": "趋于",
    "⇒": "推出",
    "≤": "小于等于",
    "≥": "大于等于",
    "≠": "不等于",
    "<": "小于",
    ">": "大于",
    "=": "等于",
    "×": "乘以",
    "·": "乘以",
    "÷": "除以",
    "/": "除以",
    "+": "加",
    "−": "减",
    "√": "根号",
    "′": "的一阶导数",
    "₀": "下标零",
    "₁": "下标一",
    "₂": "下标二",
    "ₙ": "下标 n",
    "ₖ": "下标 k"
  },
  "cleanup": [
    [
      "\\\\[\\[\\]\\(\\)]|[$#\\x60*{}]",
      " "
    ],
    [
      "\\s+",
      " "
    ]
  ]
}
