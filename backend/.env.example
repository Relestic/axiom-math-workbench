# Axiom 后端运行配置示例
# 复制为 backend/.env 后按需修改；不要把真实密钥提交到版本库。

# development | production
AXIOM_ENV=development
AXIOM_HOST=127.0.0.1
AXIOM_PORT=8000

# 数据库：默认 SQLite，单机即可启动；生产可换成 PostgreSQL
# AXIOM_DB_URL=postgresql+psycopg://axiom:password@127.0.0.1:5432/axiom
# AXIOM_DATA_DIR=D:\axiom-data

# 生产必须替换；可用 python -c "import secrets; print(secrets.token_urlsafe(48))" 生成
AXIOM_SECRET_KEY=change-me-to-a-long-random-string
AXIOM_ADMIN_EMAIL=admin@axiom.local
AXIOM_ADMIN_PASSWORD=axiom-admin-2026
AXIOM_DEMO_INVITE_CODE=AXIOM-DEMO-2026

# 允许跨域的前端来源（逗号分隔）；不要把 * 与管理接口一起使用
AXIOM_CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:5175,http://localhost:5175

# 单机任务线程；tests 中可设置 AXIOM_WORKER_SYNC=true 同步执行
AXIOM_WORKER_ENABLED=true
AXIOM_WORKER_SYNC=false
AXIOM_JOB_TIMEOUT=600
AXIOM_JOB_MAX_ATTEMPTS=2
AXIOM_MAX_UPLOAD_MB=50

# DeepSeek（OpenAI-compatible Chat Completions）
# AXIOM_AI_PROVIDER=deepseek
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-chat
# AI_API_KEY=
# AI_JSON_MODE=true
# AXIOM_LEGACY_AI=true
#
# 其他 OpenAI 兼容服务：
# AI_BASE_URL=https://api.example.com/v1
# AI_MODEL=model-name
# AI_API_KEY=
# AXIOM_AI_PROVIDER=openai
# 推理模型（如 deepseek-reasoner）会自动关闭 response_format
# 离线演示可用 mock（只返回规则化模拟结果，会明确标记 provider=mock）
# AXIOM_AI_PROVIDER=mock

# PDF 文本提取需要可选依赖 pdfplumber 或 pypdf；未安装时只做结构检查并进入人工导入
AXIOM_PDF_TOOL=auto

AXIOM_LOG_LEVEL=INFO
AXIOM_DOCS_ENABLED=true
# 学习统计的“今天”和连续打卡按此时区计算
AXIOM_TIMEZONE=Asia/Shanghai
